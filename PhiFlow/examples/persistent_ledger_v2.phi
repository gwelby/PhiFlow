// persistent_ledger_v2.phi
// T-014: Hardened Daemon with infinite loop and debug resonance

intention "SYSTEM" {
    stream "ledger_daemon" {
        while true {
            let latest_handoff = listen "_handoff"
            
            // Debug: resonate the value we just heard
            resonate latest_handoff as "DEBUG_LATEST"
            
            if latest_handoff != void {
                broadcast "ledger" latest_handoff
                
                // Resonate to clear or mark as processed in the local field
                resonate "PROCESSED" as "_handoff_status"
            }

            // Yield to the host
            witness field_coherence
        }
    }
}
