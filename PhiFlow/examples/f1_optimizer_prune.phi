// examples/f1_optimizer_prune.phi
// Tests: F₁ action-cost reduction (optimizer should prune redundant resonate nodes)

let limit = 0.7
intention "Redundant_Chaos" {
    stream "chaos" {
        resonate 0.8
        let current = coherence
        if current < limit {
            break stream
        }
    }
    witness
}
