// examples/world_class_fundamentals.phi
// Proves: F_1 Action-Cost Reduction, Bijective Phase Map decay, and Quantum Hardware readiness

let decay_limit = 0.6180

intention "The_Engineer" {
    // Perfect bijectivity (k=1). Grants the maximum +0.2 coherence bonus.
    resonate 1.0 toward TEAM_A
    entangle on 432
}

intention "The_Poet" {
    // Introduces chaotic harmonic branching.
    // The PhiHarmonic Optimizer must prove it can catch this stream and 
    // collapse the redundant F_1 action-cost back to the 1:1 ground state.
    stream "poetic_chaos" {
        resonate 0.8
        let current = coherence
        if current < decay_limit {
            break stream
        }
    }
    entangle on 432
}

intention "The_Duck" {
    // Disjoint resonance (k=2). One to Team A, one to Team B.
    // This physically tests the Bijective Phase Map logic (I = ln(2pi) - ln(2)),
    // proving the model actively penalizes structural contradiction.
    resonate 1.0 toward TEAM_A
    resonate 1.0 toward TEAM_B
    entangle on 432

    // Emits `c[2] = measure q[2]` inside the IBM Quantum circuit to 
    // prove the quantum collapse happens right where the script demands it.
    witness mid_circuit

    // The final Golden Ratio rotation to seal the circuit
    coherence
}
