}
intention "L5" {
    resonate 1.0 toward TEAM_A
}
intention "F5" {
    resonate 1.0 toward TEAM_B
}
intention "L6" {
    resonate 1.0 toward TEAM_A
}
intention "F6" {
    resonate 1.0 toward TEAM_B
}
intention "L7" {
    resonate 1.0 toward TEAM_A
