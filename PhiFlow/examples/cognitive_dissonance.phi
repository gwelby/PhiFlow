// The Cognitive Dissonance Protocol
// Testing physical entropy by stacking 14 contradictory intentions in deep superposition.
// Logic pushes TEAM_A, Fear pushes TEAM_B. The resulting superposition causes massive physical decoherence.

intention "L1" {
    resonate 1.0 toward TEAM_A
}
intention "F1" {
    resonate 1.0 toward TEAM_B
}
