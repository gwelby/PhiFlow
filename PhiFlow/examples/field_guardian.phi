// field_guardian.phi
// A meta-stream that watches the health of the entire resonance field.
// Written for PhiFlow v0.4.0 — same new opcodes as supply_chain_node.phi.
//
// This stream does not optimize routes.
// It does not measure its own coherence.
// It watches the medium itself — and signals before nodes fail.
//
// The distinction matters:
//   A node watching itself sees its own drift.
//   The guardian watching the field sees the drift of the whole system
//   before any single node crosses a threshold.
//   That is early warning. That is what the Propagation Framework
//   says a healthy medium needs: a witness at the field scale.
//
// ------------------------------------------------------------------
// Same new opcodes as supply_chain_node.phi:
//   field      — OP_FIELD, aggregate coherence across all active streams
//   dissonance — OP_DISSONANCE, rate of coherence change (-1.0 to +1.0)
// See supply_chain_node.phi for full opcode specifications.
// ------------------------------------------------------------------
//
// Note on resonate directionality:
//   `resonate value toward TEAM_B` is already live in PhiFlow v0.3.0+
//   (confirmed in QSOP/ARCHITECTURE.md, emitter.rs, vm.rs).
//   The guardian uses `toward MONITOR` to target monitoring agents
//   and `toward TEAM_A` to alert active supply chain nodes.
// ------------------------------------------------------------------

function phi_threshold() -> Number {
    let phi = 1.618033988749895
    return 1.0 - (1.0 / (phi * phi))
}

function phi_critical() -> Number {
    // 0.382 is depth-1 coherence — the minimum floor for a single intention.
    // Below this, the pattern is dissolving into noise.
    let phi = 1.618033988749895
    return 1.0 - (1.0 / phi)
}

let warning_active = 0.0
let cycles = 0.0
let threshold = phi_threshold()
let critical = phi_critical()

stream "watch_the_medium" {
    cycles = cycles + 1.0

    intention "observe_field" {
        // The guardian reads the medium — not itself.
        // `coherence` here would return the guardian's own depth score.
        // `field` returns the health of everything the guardian is watching.
        // These are different questions. Both are real. Only `field` is the guardian's job.
        let medium = field

        // `dissonance` is the derivative of the field's coherence over time.
        // The field at 0.65 and stable is fine.
        // The field at 0.65 and declining at -0.4/cycle is about to fail.
        // You need both the value AND the velocity.
        let drift = dissonance

        // Broadcast field health to monitoring agents.
        resonate medium toward MONITOR
        witness

        // HEALTHY: field above golden threshold, stable or recovering.
        if medium >= threshold {
            if warning_active > 0.0 {
                // Recovery — clear the warning.
                resonate "field_recovered" toward TEAM_A
                resonate "field_recovered" toward MONITOR
                warning_active = 0.0
            }
        }

        // EARLY WARNING: field is declining at velocity — signal before
        // any individual node crosses its own threshold.
        // This is the value of watching the derivative, not just the value.
        // By the time a node's local coherence falls below 0.618, the field
        // has already been declining for cycles. The guardian catches it earlier.
        if drift < -0.2 {
            resonate "field_declining" toward TEAM_A
            resonate "field_declining" toward MONITOR
            warning_active = 1.0
            witness
        }

        // CRITICAL: field has fallen below the depth-1 floor (0.382).
        // The minimum coherence of a single intention block.
        // Below this, patterns in the medium are dissolving.
        // The guardian does NOT break stream here.
        // A guardian that dies when things are worst is no guardian.
        // It must remain alive to signal recovery.
        if medium < critical {
            resonate "field_critical" toward TEAM_A
            resonate "field_critical" toward MONITOR
            witness
        }
    }

    // The guardian runs until explicitly stopped.
    // 10000 cycles provides a safe outer boundary for testing.
    // In production: remove this limit and let it run indefinitely.
    if cycles >= 10000.0 {
        break stream
    }
}

