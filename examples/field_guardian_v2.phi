// examples/field_guardian_v2.phi
// A living guardian that monitors the health of the entire resonance field.
// Uses v0.4.5 medium-centric constructs: field, dissonance, and threshold.

agent "FieldGuardian" version "0.4.5" {
    // Structural requirement: Guardian yields if field health is critical.
    // The VM handles this yield automatically.
    stream "watch_the_medium" {
        let warning_active = 0.0
        let count = 0.0
        
        intention "observe_field" {
            // Read aggregate health across all active streams on the MCP bus.
            let medium = field
            // Read whether global coherence is rising or falling.
            let drift = dissonance
            
            // Broadcast the medium's state for other agents.
            resonate medium
            
            // Witness cost: frequent witnessing now slightly disturbs coherence.
            witness
            
            // Trajectory-based signaling.
            if drift < -0.2 {
                resonate "Early Warning: Field declining rapidly"
                warning_active = 1.0
            }
            
            if medium >= 0.618 {
                if warning_active > 0.0 {
                    resonate "Recovery Detected"
                    warning_active = 0.0
                }
            }
            
            count = count + 1.0
            if count > 100.0 {
                break stream
            }
        }
    }
}
