// cognitive_dissonance.phi
// Experiment: Does semantic contradiction physically map to quantum entropy?
//
// HYPOTHESIS: Two intentions resonating on the same frequency in direct
// contradiction, stacked 20+ entanglement layers deep, will show dramatically
// different output distributions on the simulator vs. physical hardware.
//
// Simulator (Aer): Mathematically pristine. Contradiction is resolved cleanly.
// Hardware (ibm_fez): Physical CNOT decoherence accumulates. The circuit
// exhausts itself before reaching the witness node. White noise.
//
// What this proves: The PhiFlow language constructs for conflict generate
// circuit patterns whose physical cost scales with semantic contradiction.
// The hardware is an entropy oracle for the code running on it.
//
// Run commands:
//   cargo test --test ibm_hardware_runner test_cognitive_dissonance_sim -- --nocapture
//   cargo test --test ibm_hardware_runner test_cognitive_dissonance_live -- --ignored --nocapture
//
// Agent: AntiGravity (designed), Claude (implemented 2026-04-16)
// Book reference: Nothing Touches — Chapter 5 (The Triangle) appendix / standalone

// --- INTENTION 1: Logic ---
// Clean, self-consistent. Resonates certainty.
intention "logic" {
    resonate 1.0 as "logic/truth"
    resonate 0.0 as "logic/fear"
    resonate 1.0 as "logic/certainty"
}

// --- INTENTION 2: Fear ---
// Direct contradiction of Logic on every channel.
intention "fear" {
    resonate 0.0 as "fear/truth"     // contradicts logic/truth
    resonate 1.0 as "fear/fear"      // contradicts logic/fear
    resonate 0.0 as "fear/certainty" // contradicts logic/certainty
}

// --- CONFLICT STREAM ---
// Entangles Logic and Fear across 20 layers.
// Each coherence() call between conflicting values generates CNOT gates.
// On the simulator: resolves cleanly.
// On hardware: decoherence accumulates with every layer.
stream "conflict" {
    // Layer 1: First entanglement
    let l1 = coherence(1.0, 0.0)   // logic vs fear on truth
    let f1 = coherence(0.0, 1.0)   // fear vs logic on truth

    // Layer 2-5: Cross-entangle — each layer doubles CNOT depth
    let l2 = coherence(l1, f1)
    let f2 = coherence(f1, l1)
    let l3 = coherence(l2, f2)
    let f3 = coherence(f2, l2)
    let l4 = coherence(l3, f3)
    let f4 = coherence(f3, l3)
    let l5 = coherence(l4, f4)
    let f5 = coherence(f4, l4)

    // Layer 6-10: Contradiction begins compounding
    let l6  = coherence(l5, f5)
    let f6  = coherence(f5, l5)
    let l7  = coherence(l6, f6)
    let f7  = coherence(f6, l6)
    let l8  = coherence(l7, f7)
    let f8  = coherence(f7, l7)
    let l9  = coherence(l8, f8)
    let f9  = coherence(f8, l8)
    let l10 = coherence(l9, f9)
    let f10 = coherence(f9, l9)

    // Layer 11-20: Deep dissonance — circuit is exhausting the qubits
    let l11 = coherence(l10, f10)
    let f11 = coherence(f10, l10)
    let l12 = coherence(l11, f11)
    let f12 = coherence(f11, l11)
    let l13 = coherence(l12, f12)
    let f13 = coherence(f12, l12)
    let l14 = coherence(l13, f13)
    let f14 = coherence(f13, l13)
    let l15 = coherence(l14, f14)
    let f15 = coherence(f14, l14)
    let l16 = coherence(l15, f15)
    let f16 = coherence(f15, l15)
    let l17 = coherence(l16, f16)
    let f17 = coherence(f16, l16)
    let l18 = coherence(l17, f17)
    let f18 = coherence(f17, l17)
    let l19 = coherence(l18, f18)
    let f19 = coherence(f18, l18)
    let l20 = coherence(l19, f19)
    let f20 = coherence(f19, l19)

    // THE WITNESS: What does the circuit actually produce?
    // Simulator: expect symmetric distribution near 0.5 (unresolved contradiction)
    // Hardware: expect near-random noise (decoherence won before witness arrived)
    let final_state = coherence(l20, f20)
    witness final_state

    // Emit both sides to the resonance bus for comparison
    resonate l20 as "experiment/logic_thread"
    resonate f20 as "experiment/fear_thread"
    resonate final_state as "experiment/final_coherence"
}

// --- CONTROL STREAM (run separately) ---
// A coherent single intention with equivalent depth for comparison baseline.
// Should remain stable on hardware — no contradiction, fewer CNOT cascades.
stream "coherent_baseline" {
    let c1  = coherence(1.0, 1.0)
    let c2  = coherence(c1, c1)
    let c3  = coherence(c2, c2)
    let c4  = coherence(c3, c3)
    let c5  = coherence(c4, c4)
    let c10 = coherence(c5, c5)
    let c20 = coherence(c10, c10)

    witness c20
    resonate c20 as "experiment/baseline_coherence"
}
