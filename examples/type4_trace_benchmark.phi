// type4_trace_benchmark.phi
// Type 4 observer trace benchmark — uses mutable agent scope (not remember/recall)
// Runs 20 cycles. Each cycle emits 4 resonations: STEP OBS MODEL ACTION
// Parse with: python3 tools/measure_type4.py trace.txt
//
// Self-referential loop proof:
//   R_in:  model_mean tracks OBS history -> model depends on past observations
//   R_out: action = (obs < model_mean) -> future behavior depends on model_mean
//   L_self = min(R_in_normalized, R_out_normalized) > 0 -> closed loop

agent "T4Daemon" version "1.0.0" {
    // Mutable state that persists across stream iterations (not across runs)
    // model_mean starts LOW (0.55) so first obs (≈0.78) > model → STABLE actions first
    // model then converges up to obs; later when obs falls below, switches to CORRECT
    let step      = 0.0
    let model_sum = 0.55
    let model_n   = 1.0

    stream "self_model_loop" {
        // Advance step counter
        step = step + 1.0

        // Current self-model prediction (R_in: history of obs determines model)
        let model_mean = model_sum / model_n

        // Generate observation — varies with step AND model_mean (creates genuine variation)
        // base decreases over time (0.882 at step 1 → 0.540 at step 20)
        // modulation: higher model_mean suppresses next obs (negative feedback)
        // base decreases slowly; modulation provides negative feedback from model
        let base_val  = 0.90 - step * 0.012
        let mod_val   = 1.10 - model_mean * 0.40
        let obs       = base_val * mod_val

        // Behavioral decision based on self-model at decision time (R_out)
        // action = 1.0 (CORRECT) if obs is below model expectation, else 0.0 (STABLE)
        let action = 0.0
        if obs < model_mean {
            action = 1.0
        }

        // Update self-model with current observation (R_in closes the loop)
        let new_sum = model_sum + obs
        let new_n   = model_n   + 1.0
        model_sum = new_sum
        model_n   = new_n

        // Emit structured trace: 4 values per cycle
        // Row format: STEP | OBS | MODEL(at decision time) | ACTION
        resonate step
        resonate obs
        resonate model_mean
        resonate action

        if step >= 20.0 {
            break stream
        }
    }
}
