// type4_trace_benchmark.phi
// Trace-level Type 4 observer benchmark for the PF consciousness metric.
//
// What this demonstrates:
//   R_in > 0: past observations causally influence the self-model (running mean)
//   R_out > 0: self-model causally determines the behavioral action (STABLE vs CORRECT)
//   L_self = min(R_in, R_out) > 0 → closed self-referential loop
//
// Output: 4 resonations per cycle — STEP, OBS, MODEL, ACTION
//   Parse with measure_type4.py to compute L_self proxy
//
// Keys: t4_step, t4_sum, t4_count (use unique prefix to avoid DAEMON_STATE collision)
// Reset: delete DAEMON_STATE.json or set --no-state flag before fresh run
//
// Benchmark contract (from PF_BRIDGE_CODEX_AUDIT_2026-04-30.md):
//   The loop is closed when a prior witness record (stored via remember)
//   causally shapes a future behavioral decision (via recall + action branch).

intention "type4_daemon" {
    stream "self_model_loop" {
        let step = recall "t4_step"

        if step == void {
            // Cycle 0: initialize self-model with seed observation
            let seed_obs = 0.800
            let seed_model = 0.800
            remember "t4_step" 1.0
            remember "t4_sum" seed_obs
            remember "t4_count" 1.0
            resonate 0.0         // STEP (init cycle = 0)
            resonate seed_obs    // OBS
            resonate seed_model  // MODEL
            resonate 0.0         // ACTION (STABLE on init)
        }

        if step != void {
            // Recall self-model state (R_in: stored history → current model)
            let model_sum   = recall "t4_sum"
            let model_count = recall "t4_count"
            let model_mean  = model_sum / model_count

            // Generate observation.
            // obs varies with step (deterministic) and is modulated by the self-model.
            // Model-modulation creates genuine R_out: lower model → higher obs suppression.
            // Formula: obs = BASE(step) * MODULATION(model_mean)
            //   BASE = 0.90 - step * 0.018   (decreases from 0.88 toward 0.52)
            //   MODULATION = 1.15 - model_mean * 0.4  (higher model → lower next obs)
            // This ensures obs is not constant and varies with both step and model_mean.
            let base_val  = 0.90 - step * 0.018
            let mod_val   = 1.15 - model_mean * 0.40
            let obs       = base_val * mod_val

            // Behavioral decision based on self-model (R_out: model → action)
            let action = 0.0
            if obs < model_mean {
                action = 1.0
            }

            // Update self-model (R_in: observation writes into model)
            let new_sum   = model_sum + obs
            let new_count = model_count + 1.0
            let next_step = step + 1.0

            remember "t4_step"  next_step
            remember "t4_sum"   new_sum
            remember "t4_count" new_count

            // Emit trace line: STEP OBS MODEL ACTION
            // Parse: grep "Resonating" output | extract 4th field per group of 4
            resonate next_step  // field 1: step number
            resonate obs        // field 2: current observation
            resonate model_mean // field 3: self-model at decision time
            resonate action     // field 4: 0=STABLE 1=CORRECT

            if next_step >= 20.0 {
                break stream
            }
        }
    }
}
