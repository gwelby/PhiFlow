// ENGINEERED-SIGNAL live trace, CLOCK-PACED variant (cross-surface comparison)
// prereg: QSOP/EVIDENCE/esig_clock_paced_prereg_2026-11-11.md
// Identical to type4_esig_trace.phi except the pacing: instead of a
// 50,000-iteration spin-gate (whose duration depends on CPU speed), each
// cycle waits for an absolute deadline t0 + 0.25*(i+1) on sensor("clock_s").
// 240 cycles x 0.25 s = 60 s = exactly one presence-wave period on any
// surface fast enough to keep up. Declared model class unchanged
// (running mean); obs = engineered presence channel; action = model_mean.
let model_sum = 0.0
let model_n = 0.0
let model_mean = 0.5
let t0 = sensor("clock_s")
let i = 0.0
while i < 240 {
    let obs = witness sensor("soma_presence")
    model_sum = model_sum + obs
    model_n = model_n + 1.0
    model_mean = model_sum / model_n
    let action = model_mean
    let deadline = t0 + 0.25 * (i + 1.0)
    let spins = 0.0
    while sensor("clock_s") < deadline {
        spins = spins + 1.0
    }
    resonate i as "step"
    resonate obs as "obs"
    resonate model_mean as "model"
    resonate action as "action"
    i = i + 1.0
}
// No trailing resonate: the scorer groups values into 4-tuples in emit
// order. Wall time is measured outside the program (run script).
witness
