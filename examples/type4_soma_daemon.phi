// type4_soma_daemon.phi
// Type-4 daemon-coupled trace — the PROGRAM is the observer.
//
// Difference from scripts/collect_soma_trace.py (2026-10-07 real-trace FAIL):
//   collector: Python running-mean stood proxy for the model — host-carried state
//   this:      model lives in the program's own mutable agent state, persists
//              across daemon yields AND restarts via --state-path.
//              obs comes from live SOMA; the branch is the program's own action.
//
// obs channel contract matches collect_soma_trace.py for comparability:
//   primary: soma_presence · fallback: soma_peak_dbc * 0.05 (capped 1.0)
//
// Run (evaluator path — the hypervisor wedges after ~2 council cycles, defect
// under investigation; semantics identical: program-carried model + live SOMA):
//   SOMA_STATE_PATH=/mnt/d/Projects/PhiHarmonic/SOMA/soma_state.json \
//   cargo run --release --bin phic -- examples/type4_soma_daemon.phi
//
// Preregistered criteria: QSOP/EVIDENCE/type4_daemon_prereg_2026-10-09.md
// Canonical verdict: Trace::from_type4_trace (same path as the FAIL).

agent "T4SomaDaemon" version "1.0.0" {
    // model starts EMPTY — it must learn from live obs, no warm-start bias
    let step      = 0.0
    let model_sum = 0.0
    let model_n   = 0.0
    let gate      = 0.0

    stream "soma_self_model" {
        // OBS: live sensor read on every spin of the language loop.
        let obs = witness sensor("soma_presence")
        if obs <= 0.0 {
            // mic-absent hosts (WSL): presence is dead — use ring/audio floor
            let dbc = witness sensor("soma_peak_dbc")
            obs = dbc * 0.05
            if obs > 1.0 {
                obs = 1.0
            }
        }

        // PACING GATE: the loop spins at ~10-50k instructions/sec — far
        // faster than SOMA's ~5Hz fusion. Emit one sample per ~100k spins
        // ≈ 1Hz — slower than the collector's 5Hz, so conservative
        // (slower sampling can't inflate autocorrelation the way
        // faster-than-fusion polling would). Effective rate is measured
        // externally and recorded in the evidence file.
        gate = gate + 1.0
        if gate >= 100000.0 {
            gate = 0.0
            step = step + 1.0

            // MODEL: program-carried running mean. Empty until first obs.
            let model_mean = 0.5
            if model_n > 0.0 {
                model_mean = model_sum / model_n
            }

            // ACTION: the program's own branch. Grace window — the first 5
            // samples are listen-only so actions carry signal.
            let action = 0.0
            if model_n >= 5.0 {
                if obs < model_mean {
                    action = 1.0
                }
            }

            // R_in closes: model absorbs the live observation
            model_sum = model_sum + obs
            model_n   = model_n   + 1.0

            // Canonical 4-tuple: STEP | OBS | MODEL(at decision) | ACTION
            resonate step
            resonate obs
            resonate model_mean
            resonate action
        }

        if step >= 600.0 {
            break stream
        }
    }

    resonate step as "samples_taken"
}
